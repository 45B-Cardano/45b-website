<IfModule mod_headers.c>
   Header set Access-Control-Allow-Origin "*"
 </IfModule>

# --- 45B, added 2026-09-08 -------------------------------------------------
# STANDING POLICY, not a temporary measure and not scoped to any date: 45B
# pages are never cached client-side. Returning visitors must always see the
# current page. First driven by the /web3 landing page, where a cached copy
# showed stale dates and stale calls-to-action, but it applies to all 45B web
# properties and tools. Do not remove without asking Lucas.
#
# HTML only, deliberately: JS/CSS/images in this shared root are not all
# content-hashed, so a long-cache rule here could freeze stale assets for the
# unrelated content living alongside the 45b-website build. Our own bundles
# are content-hashed and bust themselves.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
